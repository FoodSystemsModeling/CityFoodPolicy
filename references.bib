@article{anProcurementWelfarePrograms,
	title = {Procurement in welfare programs: Evidence and implications from {WIC} infant formula contracts},
	abstract = {This paper examines the impact of government procurement in social welfare programs on consumers, manufacturers, and the government. We analyze the U.S. infant formula market, where over half of total sales are procured by the Women, Infants, and Children ({WIC}) program through first-price sealed-bid auctions, which grant the winner exclusive rights to serve all {WIC} participants in the awarded market. Reduced-form results confirm the presence of significant spill-over effects of the exclusive rights on non-{WIC} consumers’ demand. We propose and estimate a structural model of non-{WIC} consumers’ demand and manufacturers’ competition. The results demonstrate that the exclusive rights generate spillover effects, marginal cost savings, and price inflation opportunities. Our counterfactual analyses further show that the exclusive rights affect manufacturers asymmetrically, with the smallest manufacturer being the most adversely affected. More importantly, if the government adopts a predetermined inclusive rebate scheme instead of exclusive auctions, it can still effectively contain costs, significantly enhance consumer surplus, and reduce the smallest manufacturer’s competitive disadvantage, thereby fostering greater market competition.},
	author = {An, Yonghong and Davis, David and Liu, Yizao and Xiao, Ruli},
	langid = {english},
	file = {An et al. - Procurement in welfare programs Evidence and impl.pdf:/Users/alg24/Zotero/storage/RTV4ZYZD/An et al. - Procurement in welfare programs Evidence and impl.pdf:application/pdf},
}

