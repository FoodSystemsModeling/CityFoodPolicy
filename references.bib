@misc{yiStrengtheningOurUnderstanding2021,
	title = {Strengthening {Our} {Understanding} of the {Food}-{Energy}-{Water} {Nexus} through {Completing} {Suppressed} {Datasets}},
	url = {https://www.google.com/url?sa=t&rct=j&q=&esrc=s&source=web&cd=&ved=2ahUKEwjJwbfqytuEAxVVJzQIHTQOB74QFnoECB0QAQ&url=https%3A%2F%2Fageconsearch.umn.edu%2Frecord%2F312901%2Ffiles%2FAbstracts_21_06_18_06_14_18_04__107_77_223_181_0.pdf&usg=AOvVaw3qF8yohFQjj9L9eknSdzQX&opi=89978449},
	abstract = {The demand for food, energy, and water (FEW) from agricultural production will rise with
population growth, urbanization, and income. Agricultural production, however, contributes to
freshwater depletion, energy consumption, and land use. Without effective mitigation, the food
system's environmental impact is estimated to increase by 50-92\% between 2010 and 2050,
which could be beyond the safe operating space for humanity. An extensive literature
emphasizes the urgent need for multidisciplinary scientific efforts to better understand the FEW
nexus. However, suppressions in public data due to privacy laws critically reduce the utility of
data and hinder research applications. This study uses Census of Agriculture datasets to
demonstrate and validate a data imputation methodology to complete suppressed datasets. The
methodology can be applied to other incomplete datasets to bolster FEW nexus research.},
	publisher = {AgEcon Search; Research in Agricultural \& Applied Economics Digital Library},
	author = {Yi, Jing and Cohen, Samantha and Rehkamp, Sarah and Gomez, Miguel I and Ge, Houtian and Jaromczyk, Jerzy},
	month = aug,
	year = {2021},
}

@misc{yiNationalDatabaseHighly2023,
	title = {A national database of highly perishable fresh produce production with temporal and spatial resolution},
	url = {https://ageconsearch.umn.edu/nanna/record/335590/files/26607.pdf?withWatermark=0&withMetadata=0&version=1&registerDownload=1},
	abstract = {Despite the growing demand for information in the rapid changing fresh produce production and marketing system, there is no monthly fresh produce production data at the county levels due to the high cost and time-consuming nature of data collection and processing. In this study, we address the challenge by presenting a national database of monthly highly perishable fresh produce production at the county level, by using machine learning and economic models to synthesize publicly available data. The study covers 34 varieties of highly perishable produce and provides valuable insights for academic researchers and food policy makers interested in measuring production aggregation, distribution, and marketing. The study also demonstrates the great values of applying data synthesis and simulation in agri-food research for promoting food system sustainability, reducing waste, and mitigating climate change.},
	publisher = {AgEcon Search; Research in Agricultural \& Applied Economics Digital Library},
	author = {Yi, Jing and Canning, Patrick and Rehkamp, Sarah and Houtian, Frank Ge and Gomez, Miguel I},
	month = jul,
	year = {2023},
}

