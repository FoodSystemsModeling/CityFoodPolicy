@misc{OverviewFoodSecurity2021,
	title = {An Overview of Food Security in a Context of Urbanization},
	url = {https://unhabitat.org/an-overview-of-food-security-in-a-context-of-urbanization},
	shorttitle = {Un Panorama de la Seguridad Almentaria en un Contexto de Urbanizacion},
	abstract = {An overview of food security in a context of urbanization and guidelines for the design of comprehensive food systems within the framework of the National Policy for the Comprehensive Development of the Cities of the Plurinational State of Bolivia.

Bolivia, despite having an exhaustive regulatory framework in relation to food security and sovereignty, there is still a gap specifically related to the new challenges related to guaranteeing food security, the promotion of comprehensive food systems and the right to food in a context of greater urbanization.

Urban residents are integrated into a market economy and their food consumption is monetized; therefore, its consumption is defined around the market supply and in relation to its economy. In this context, the urban poor are more vulnerable to food insecurity and are more vulnerable to market fluctuations, because their consumption possibilities are significantly influenced by the slightest changes in their income and the price of food.

In this framework, The study -promoted with the support of the Swedish International Development Agency- proposes four guidelines for the development of agri-food systems:

Guideline 1: Development of productive capacities
Guideline 2: Reconfiguration of commercialization spaces
Guideline 3: Educational strategies with a nutritional food approach
Guideline 4: Governance and Citizen Participation},
	publisher = {{UN}-Habitat},
	date = {2021-06},
}

@misc{garrettUrbanRuralLinkagesNutrition2020,
	title = {Urban-Rural Linkages for Nutrition; Territorial Approaches for Sustainable Development},
	url = {https://urbanpolicyplatform.org/download/urban-rural-linkages-for-nutrition/},
	shorttitle = {Urban-Rural Linkages for Nutrition},
	abstract = {The nutrition challenges facing the world of today are daunting. One out of three people suffers from at least one form of malnutrition, and current trends suggest this may increase in the coming years. Every country in every region in the world is affected. The causes of malnutrition are multisectoral, and so reaching global and national goals requires addressing numerous underlying and structural factors as well as securing the concerted attention of a broad range of actors. The persistence of malnutrition has severe consequences for social and economic development, thus inhibiting attainment of many of the Sustainable Development Goals ({SDGs}). The systems that determine nutrition need to undergo transformational change. The 2030 Agenda for Sustainable Development and the {UN} Decade of Action on Nutrition (2016-2025) reaffirm this analysis and call to action.},
	publisher = {{UNSCN}: United Nations System Standing Committee on Nutrition},
	author = {Garrett, James and Grigoletto, Riccardo and Egal, Florence and Forster, Thomas and Oenema, Stineke},
