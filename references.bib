@article{hoekmanProcurementPolicySME2022,
	title = {Procurement policy and {SME} participation in public purchasing},
	volume = {58},
	issn = {1573-0913},
	url = {https://doi.org/10.1007/s11187-020-00414-z},
	doi = {10.1007/s11187-020-00414-z},
	abstract = {This study investigates the relationship between regulatory policies governing public procurement and participation by small and medium enterprises ({SMEs}), using a large dataset on European procurement. We find that better quality procurement regulation is associated with greater {SME} participation and higher probability that {SMEs} win contracts. Dividing contracts into smaller lots, a key feature of 2014 {EU} procurement regulation reform, bolsters participation by {SMEs} but only increases the probability of {SMEs} winning contracts for small value lots (€25,000 or less). Our results suggest governments seeking to enhance participation by {SMEs} in public procurement without explicitly favoring {SMEs} can do so by improving the overall quality of procurement processes.},
	pages = {383--402},
	number = {1},
	journaltitle = {Small Business Economics},
	shortjournal = {Small Bus Econ},
	author = {Hoekman, Bernard and Taş, Bedri Kamil Onur},
	urldate = {2024-01-09},
	date = {2022-01-01},
	langid = {english},
	keywords = {Good practice, H57, L26, Lot size, O12, Public procurement, Regulation, {SME} participation},
	file = {Full Text PDF:/Users/alg24/Zotero/storage/ITQBZR9I/Hoekman and Taş - 2022 - Procurement policy and SME participation in public.pdf:application/pdf;s11187-020-00414-z.pdf:/Users/alg24/Zotero/storage/Z22H7DUT/s11187-020-00414-z.pdf:application/pdf},
}

@article{wenAidingFarmSchool2022,
	title = {Aiding farm to school implementation: An assessment of facilitation mechanisms},
	volume = {51},
	issn = {1068-2805, 2372-2614},
	url = {https://www.cambridge.org/core/journals/agricultural-and-resource-economics-review/article/aiding-farm-to-school-implementation-an-assessment-of-facilitation-mechanisms/43B90BD1B3D8AB3A46E5833857B8416B},
	doi = {10.1017/age.2022.3},
	shorttitle = {Aiding farm to school implementation},
	abstract = {We investigated two potential mechanisms facilitating local food procurement in schools, food hubs, and funded farm to school policies. Using all three waves of the {USDA}’s farm to school census, we assessed the factors that support school districts that have stated an intention of beginning a farm to school program. We find that neither food hubs nor funded policies have an impact on farm to school programming. Instead, it is large-scale farms that play a role in the farm to school supply chain. Coupled with the positive impact of school size and receipt of increased federal funding, this suggests that while both cost and transactional barriers impact school procurement, current policy solutions are insufficient. This study improves our understanding of the role of facilitation mechanisms on farm to school implementation in the United States.},
	pages = {311--342},
	number = {2},
	journaltitle = {Agricultural and Resource Economics Review},
	publisher = {Cambridge University Press},
	author = {Wen, Ce and Connolly, Cristina},
	urldate = {2024-01-09},
	date = {2022-08},
	langid = {english},
	keywords = {farm to school, food hubs, policy},
	file = {Full Text PDF:/Users/alg24/Zotero/storage/GC2MGJMN/Wen and Connolly - 2022 - Aiding farm to school implementation An assessmen.pdf:application/pdf},
}

@report{canningRevisedExpandedFood2011,
	title = {A Revised and Expanded Food Dollar Series: A Better Understanding of Our Food Costs},
	abstract = {A new {ERS} food dollar series measures annual expenditures on domestically produced food by individuals living in the United States and provides a detailed answer to the question “For what do our food dollars pay?” This new data product replaces the old marketing bill series, which was discontinued due to measurement problems and limited scope. The new food dollar series is composed of three primary series, shedding light on different aspects of evolving supply chain relationships. The marketing bill series, like the old marketing bill series, identiﬁes the distribution of the food dollar between farm and marketing shares. The industry group series identiﬁes the distribution of the food dollar among 10 distinct food supply chain industry groups. The primary factor series identiﬁes the distribution of the food dollar in terms of U.S. worker salaries and beneﬁts, rents to food industry property owners, taxes, and imports. To provide even more information about modern food supply chains, each of the three primary series is further disaggregated by commodity groupings (food/food and beverage), expenditure categories (total, food at home, food away from home), and two dollar denominations (nominal, real). The input-output methodology behind the new food dollar series and comparisons with the old marketing bill series are presented. Several key ﬁndings of the new series are highlighted and discussed.},
	number = {114},
	author = {Canning, Patrick},
	date = {2011-02},
	langid = {english},
	file = {Canning - A Revised and Expanded Food Dollar Series A Bette.pdf:/Users/alg24/Zotero/storage/YQ2YDYAX/Canning - A Revised and Expanded Food Dollar Series A Bette.pdf:application/pdf},
}

