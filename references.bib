	url = {https://www.cambridge.org/core/journals/agricultural-and-resource-economics-review/article/financial-performance-implications-of-differential-marketing-strategies-exploring-farms-that-pursue-local-markets-as-a-core-competitive-advantage/66E6D8AC2B1322D0A7FAE855058A871C},
